# MfgMax environment reference (safe placeholders only - never commit real values)
# Copy to .env and fill in. Verified against every process.env usage in src/, desktop/, scripts/, next.config.ts.
# Env flag matrix also documented in docs/OFFLINE_EDITION.md.

# DATABASE
DATABASE_URL="postgresql://user:pass@localhost:5432/manufacturing_max"
# (desktop edition uses: DATABASE_URL="file:<data>/app.db")

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-32-chars-min"
CRON_SECRET="change-me-long-random"
AUTH_ENABLED="true" # Set to "false" only during local mock prototyping
APP_VERSION=""
PORT=""

# BOOTSTRAP CREDENTIALS (only used when DB is empty; defaults: admin/factory123, operator/operator123)
ADMIN_USER=""
ADMIN_PASSWORD=""
OPERATOR_USER=""
OPERATOR_PASSWORD=""

# EMAIL (optional - digest/challan delivery via Resend)
RESEND_API_KEY=""
EMAIL_FROM="alerts@yourdomain.in"

# GOOGLE SSO (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# RAZORPAY (optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# UPDATES (optional - zero-Vercel GitHub releases channel)
GITHUB_UPDATE_REPO="maheshv1996/manufacturing-max-updates"
GITHUB_API_BASE=""

# DESKTOP LAUNCHER (set automatically by the .exe; dev overrides only)
DESKTOP_MODE="false"
BACKUP_DIR=""
LOG_DIR=""
MFGMAX_DATA_DIR=""
MFGMAX_APP_ROOT=""
MFGMAX_RESOURCES_DIR=""
MFGMAX_LICENSE=""
MFGMAX_LICENSE_SECRET=""
MFGMAX_LICENSE_SERVER=""
MFGMAX_START_ON_BOOT="false"
MFGMAX_CONTROL_TOKEN=""
MFGMAX_CONTROL_PORT=""
POSTGRES_BIN_DIR=""

# RESERVED (documented in docs/OFFLINE_EDITION.md; no code consumer yet)
# CLOUD_BRIDGE="false"
# UPDATE_MARKER (internal - used by updater tests only, do not set)
