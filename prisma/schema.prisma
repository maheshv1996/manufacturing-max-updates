generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RndProjectType {
  PRODUCTION
  RND
}

enum TestCampaignStatus {
  PLANNED
  RUNNING
  COMPLETE
}

enum TestResult {
  PENDING
  PASS
  FAIL
}

model EnergyReading {
  id             String   @id @default(cuid())
  date           DateTime @unique
  totalKwh       Float
  unitCostPerKwh Float
  totalCost      Float
}

// Removed UserRole enum

enum UserLevel {
  WORKER
  MANAGER // department head — approve/override actions require this level
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum DowntimeCategory {
  MECHANICAL
  ELECTRICAL
  MATERIAL
  QUALITY
  OPERATOR
}

enum MachineState {
  RUNNING
  IDLE
  SETUP
  FAULT
  OFF
}

enum ProjectType {
  KAIZEN
  DMAIC
}

enum ProjectPhase {
  DEFINE
  MEASURE
  ANALYZE
  IMPROVE
  CONTROL
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum FishboneCategory {
  MAN
  MACHINE
  METHOD
  MATERIAL
  MEASUREMENT
  ENVIRONMENT
}

enum ActionItemStatus {
  OPEN
  DONE
}

enum LogStatus {
  DRAFT
  FINALIZED
}

enum QuotationStatus {
  DRAFT
  SENT
  WON
  LOST
  CONVERTED
}

enum TaxType {
  INTRA
  INTER
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

model Plant {
  id           String                 @id @default(cuid())
  name         String
  code         String?                @unique
  city         String?
  address      String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  isActive     Boolean                @default(true)
  lines        ProductionLine[]
  machines     Machine[]
  workOrders   WorkOrder[]
  rawMaterials RawMaterial[]
  transactions InventoryTransaction[]
  users        User[]
}

model ProductionLine {
  id        String    @id @default(cuid())
  name      String
  plantId   String?
  plant     Plant?    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isActive  Boolean   @default(true)
  machines  Machine[]

  @@index([plantId])
}



model Machine {
  id                    String               @id @default(cuid())
  name                  String
  code                  String               @unique
  lineId                String
  line                  ProductionLine       @relation(fields: [lineId], references: [id], onDelete: Cascade)
  plantId               String?
  plant                 Plant?               @relation(fields: [plantId], references: [id], onDelete: Cascade)
  idealCycleTimeSeconds Float                @default(60.0)
  status                String               @default("RUNNING") // Manual override status
  currentState          MachineState         @default(OFF) // IoT status
  lastPingAt            DateTime?
  iotEnabled            Boolean              @default(false)
  stationName           String?
  oeeTarget             Float                @default(85.0)
  oeeGoodThreshold      Float                @default(85.0)
  oeeWarningThreshold   Float                @default(70.0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  isActive              Boolean              @default(true)
  productionLogs        ProductionLog[]
  downtimeLogs          DowntimeLog[]
  qualityMeasurements   QualityMeasurement[]
  improvementProjects   ImprovementProject[]
  shiftHandovers        ShiftHandover[]
  safetyIncidents       SafetyIncident[]
  safetyAudits          SafetyAudit[]
  certifications        Certification[]
  assignments           Assignment[]
  shiftCounts           ShiftCount[]
  reworkOrders          ReworkOrder[]
  tools                 Tool[]
  maintenanceJobs       MaintenanceJob[]
  fixtures              Fixture[]
  pmRules               PMRule[]
  maintenanceTools      MaintenanceTool[]
    routingSteps          RoutingStep[]
  telemetryLogs         TelemetryLog[]
  ipccRuns              IpccChecklistRun[]
  capacityWindows       CapacityWindow[] // P18 — S&OP windows (outsource / maintenance)
  logsheets             Logsheet[] // P3 — shopfloor logsheet verification

  @@index([lineId])
  @@index([plantId])
}

model TelemetryLog {
  id         String       @id @default(cuid())
  machineId  String
  machine    Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  state      MachineState
  cycleCount Int?
  at         DateTime     @default(now())

  @@index([machineId])
  @@index([at])
  @@index([machineId, at])
}

model Operation {
  id                      String        @id @default(cuid())
  code                    String        @unique
  name                    String
  defaultCycleTimeSeconds Float         @default(60.0)
  createdAt               DateTime      @default(now())
  isActive                Boolean       @default(true)
  routingSteps            RoutingStep[]
  documents               Document[]
}

model RoutingStep {
  id                       String             @id @default(cuid())
  productId                String
  product                  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  operationId              String
  operation                Operation          @relation(fields: [operationId], references: [id], onDelete: Cascade)
  machineId                String?
  machine                  Machine?           @relation(fields: [machineId], references: [id], onDelete: SetNull)
  seq                      Int
  stationName              String
  standardCycleTimeSeconds Float?
  setupTimeMin             Int                @default(15)
  cycleTimeMin             Float              @default(2.5)
  instructions             String?
  isHoldPoint              Boolean            @default(false)
  holdAuthority            String?
  specialProcessVendorId   String?
  specialProcessVendor     SpecialProcessVendor? @relation(fields: [specialProcessVendorId], references: [id], onDelete: SetNull)
  holdPointSignoffs        HoldPointSignoff[]

  @@unique([productId, seq])
  @@index([productId])
  @@index([operationId])
  @@index([machineId])
  @@index([specialProcessVendorId])
}

model Project {
  id                   String        @id @default(cuid())
  name                 String
  code                 String        @unique @default(cuid())
  clientName           String
  targetCompletionDate DateTime
  status               ProjectStatus @default(OPEN)
  completionPercentage Float         @default(0.0)
  description          String?
  projectType          RndProjectType   @default(PRODUCTION)
  salesOwner           String? // P29 — named owner alerted on program risk
    createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  workOrders           WorkOrder[]
  milestones           ProjectMilestone[]

  @@index([status])
  @@index([clientName])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  dueDate     DateTime
  status      String    @default("OPEN") // OPEN | COMPLETED
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  docs        MilestoneDoc[] // M29 - deliverable doc pack gates completion

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model MovementLog {
  id                String    @id @default(cuid())
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromStation       String
  toStation         String
  quantity          Int
  movedByName       String
  at                DateTime  @default(now())
  adjustmentHistory Json?

  @@index([workOrderId])
  @@index([at])
}

model Product {
  id                     String          @id @default(cuid())
  sku                    String          @unique
  name                   String
  description            String?
  unit                   String? // stockkeeping unit of measure, e.g. pcs/kg/m (import wizard template)
  targetCycleTimeSeconds Float             @default(60)
  materialCostPerUnit    Float?
  sellingPricePerUnit    Float?
  toolingCost            Float? // engineering tooling estimate → P5 quotation feed
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  isActive               Boolean         @default(true)
  workOrders             WorkOrder[]
  routingSteps           RoutingStep[]
  bomLines               BomLine[]
  documents              Document[]
  quotationLines         QuotationLine[]
  serialUnits            SerialUnit[]
  qcParameters           QCParameter[]
  faiReports             FaiReport[]
  ncrReports             NcrReport[]
  eightDReports          EightDReport[]
  ppapSubmissions        PpapSubmission[]
  controlPlans           ControlPlan[]
  fixtures               Fixture[]
  priceRevisions         PriceRevision[] // P19 — price revision register
  salesOrderLines        SalesOrderLine[]
}

model Shift {
  id              String          @id @default(cuid())
  name            String
  startTime       String
  endTime         String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isActive        Boolean         @default(true)
  productionLogs       ProductionLog[]
  shiftHandovers       ShiftHandover[]
  assignments          Assignment[]
  attendanceLogs       AttendanceLog[]
  fromShiftCounts      ShiftCount[]        @relation("FromShiftCount")
  toShiftCounts        ShiftCount[]        @relation("ToShiftCount")
  rosterEntries        RosterEntry[] // P24 — weekly shift roster
  logsheets            Logsheet[] // P3 — shopfloor logsheet verification
  packagingScanLogs    PackagingScanLog[]
}

// P24 — weekly shift roster: manager publishes, workers see their own on the terminal,
// leave approvals are guarded by minimum staffing, and roster-vs-attendance is reportable.
model ShiftRoster {
  id          String        @id @default(cuid())
  weekStart   DateTime
  status      String        @default("PUBLISHED") // DRAFT | PUBLISHED
  publishedBy String
  publishedAt DateTime      @default(now())
  notes       String?
  entries     RosterEntry[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([weekStart])
  @@index([weekStart])
}

model RosterEntry {
  id        String      @id @default(cuid())
  rosterId  String
  roster    ShiftRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime    @default(now())

  @@unique([rosterId, userId, date])
  @@index([userId])
  @@index([date])
  @@index([shiftId])
}

// P3 — shopfloor logsheet: the operator's manual shift record for a machine.
// Supervisor verification cross-checks the sheet against system production logs.
enum LogsheetStatus {
  OPEN
  SUBMITTED
  VERIFIED
  REJECTED
}

model Logsheet {
  id                String         @id @default(cuid())
  machineId         String
  machine           Machine        @relation(fields: [machineId], references: [id], onDelete: Cascade)
  shiftId           String
  shift             Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  operatorId        String?
  operator          User?          @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  logDate           DateTime // plant-local day the sheet covers (startOfDay)
  entries           Json // [{ type: GOOD|SCRAP|REWORK|DOWNTIME|SETUP|CHANGEOVER, qty?, minutes?, at, note }]
  remarks           String?
  status            LogsheetStatus @default(OPEN)
  submittedAt       DateTime?
  verifiedBy        String?
  verifiedAt        DateTime?
  verificationNote  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([machineId, shiftId, logDate])
  @@index([machineId, logDate])
  @@index([status])
}

// P25 — live-data appraisal: efficiency + quality + attendance auto-score, manager rating + comments
model PerformanceAppraisal {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          String // "2026-08" month or "2026-H1" half
  efficiencyPct   Float     @default(0) // auto — production vs standard time
  qualityPct      Float     @default(0) // auto — 100 − scrap rate
  attendancePct   Float     @default(0) // auto — attendance rate
  score           Float     @default(0) // weighted auto score
  managerRating   Int? // 1–5
  managerComments String?
  status          String    @default("AUTO") // AUTO | REVIEWED
  reviewedByName  String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, period])
  @@index([period])
  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // lowercase username/email attempted
  success    Boolean  @default(false)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}

model User {
  leaveRequests      LeaveRequest[]
  approvedLeaves     LeaveRequest[]      @relation("ApprovedLeaves")
  id                 String              @id @default(cuid())
  name               String
  email              String?             @unique
  username           String?             @unique
  employeeNumber     String?             @unique // badge / employee-number login (resolved before username/email)
  passwordHash       String?
  lastSetPassword    String?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean             @default(false)
  sessionEpoch       Int                 @default(0) // bumped on role/permission change to rotate sessions
  roleId             String?
  role               Role?               @relation(fields: [roleId], references: [id])
  createdById        String?
  creator            User?               @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers       User[]              @relation("UserCreator")
  isOwner            Boolean             @default(false)
  level              UserLevel           @default(WORKER) // WORKER sees "My" queues; MANAGER sees Approvals + Team KPIs + Budget
  homePlantId        String?
  homePlant          Plant?              @relation(fields: [homePlantId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isActive           Boolean             @default(true)
  prefs              Json?
  productionLogs     ProductionLog[]
  downtimeLogs       DowntimeLog[]
  qualityInspections QualityInspection[]
  assignments        Assignment[]
  attendanceLogs     AttendanceLog[]
  routineProgress    RoutineProgress[]
  certifications     Certification[]
  outgoingCounts     ShiftCount[]        @relation("OutgoingUserCount")
  incomingCounts     ShiftCount[]        @relation("IncomingUserCount")
  approvedNcrs       NcrReport[]         @relation("ApprovedNcrs")
  accessCertifications AccessCertification[]
  overtimeRequests   OvertimeRequest[]
  ipccRuns           IpccChecklistRun[]
  purchaseRequisitions PurchaseRequisition[] // P14 — assigned buyer
  collectionAccounts CollectionAccount[] // P22 — collections workflow
  rosterEntries        RosterEntry[] // P24 — weekly shift roster
  appraisals           PerformanceAppraisal[] // P25 — live-data appraisal
  trainingAttendances  TrainingAttendance[] // M21 — post-training checks
  grievances           Grievance[] // M22 — stage-tracked grievance register
  disciplinaryCases    DisciplinaryCase[] // M22 — stage-tracked disciplinary register
  ppeIssues            PpeIssue[] // M24 — PPE issue register
  itAssetsAssigned     ItAsset[] @relation("ItAssetAssignee") // M31
  itTicketsRaised      ItTicket[] @relation("TicketRaisedBy") // M31
  itTicketsAssigned    ItTicket[] @relation("TicketAssignedTo") // M31
  logsheets            Logsheet[] // P3 — shopfloor logsheet verification
  packagingScanLogs     PackagingScanLog[]
  employee             Employee?
}

// P22 — Collections: aging buckets, collector assignment, weekly follow-ups, dunning L1/L2/L3
model CollectionAccount {
  id            String    @id @default(cuid())
  invoiceId     String    @unique
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  collectorId   String?
  collector     User?     @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  dunningLevel  Int       @default(0) // 0 none · 1 = L1 · 2 = L2 · 3 = L3
  lastDunningAt DateTime?
  followUps     Json? // [{ at, by, note }]
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([collectorId])
  @@index([dunningLevel])
}

// P23 — Payroll approval chain: clerk generates draft → manager approves → locks + exports; post-lock = override + audit
model PayrollRun {
  id              String   @id @default(cuid())
  month           String   @unique // YYYY-MM
  status          String   @default("DRAFT") // DRAFT | APPROVED | LOCKED
  generatedByName String?
  approvedBy      String?
  approvedAt      DateTime?
  lockedBy        String?
  lockedAt        DateTime?
  corrections     Json? // [{ at, by, note, detail }]
  settledAt       DateTime?
  settledBy       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  permissions  String[]
  createdById  String?
  isSystem     Boolean  @default(false)
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkOrder {
  id                    String                 @id @default(cuid())
  woNumber              String                 @unique
  trackingMode          TrackingMode           @default(BATCH)
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  plantId               String?
  plant                 Plant?                 @relation(fields: [plantId], references: [id], onDelete: Cascade)
  plannedQuantity       Int
  status                WorkOrderStatus        @default(PLANNED)
  plannedStartDate      DateTime
  plannedEndDate        DateTime
  setupTimeMinutes      Float?
  cycleTimeSeconds      Float?
  iteration             Int                    @default(1)
    testCampaigns         TestCampaign[]
    currentSeq            Int                    @default(1)
  priority              Int                    @default(500) // M1 PPC — lower = higher priority (drag-resequenced)
  toolingCostRupees     Float                  @default(0) // M3 — tool-room issue posts to job costing
  projectId             String?
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerName          String?
  customerEmail         String?
  promisedDispatchDate  DateTime?
  trackingToken         String?                @default(cuid())
  quotedPrice           Float?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  adjustmentHistory     Json?
  productionLogs        ProductionLog[]
  downtimeLogs          DowntimeLog[]
  qualityInspections    QualityInspection[]
  movementLogs          MovementLog[]
  scrapQuarantines      ScrapQuarantine[]
  inventoryTransactions InventoryTransaction[]
  quotations            Quotation[]
  dispatchRecords       DispatchRecord[]
  invoices              Invoice[]
  customerComplaints    CustomerComplaint[]
  serialUnits           SerialUnit[]
  faiRequired           Boolean                @default(false)
  faiReports            FaiReport[]
  ncrReports            NcrReport[]
  eightDReports         EightDReport[]
  holdPointSignoffs     HoldPointSignoff[]
  dataPackages          DataPackage[]
  fqcChecklist          FqcChecklist?          // M7 — FQC dispatch checklist
  dpmBlockers           DpmBlocker[]
  ipccRuns              IpccChecklistRun[]
  materialIssueSlips    MaterialIssueSlip[] // P16
  materialCostTotal     Float                 @default(0) // P16 — job costing: RM issued × unit cost
  packedQuantity        Int                   @default(0)
    eanCode               String?
  packagingScanLogs     PackagingScanLog[]
  subcontractChallans   SubcontractChallan[]

  @@index([productId])
  @@index([projectId])
  @@index([status])
  @@index([trackingToken])
  @@index([priority])
  @@index([plannedStartDate])
  @@index([priority, plannedStartDate])
  @@index([status, plannedStartDate])
}

model ProductionLog {
  id                String    @id @default(cuid())
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  machineId         String
  machine           Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  operatorId        String?
  operator          User?     @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  shiftId           String?
  shift             Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  goodQuantity      Int       @default(0)
  scrapQuantity     Int       @default(0)
  reworkQuantity    Int       @default(0)
  startTime         DateTime
  endTime           DateTime?
  createdAt         DateTime  @default(now())
  status            LogStatus @default(DRAFT)
  adjustmentHistory Json?

  @@index([workOrderId])
  @@index([machineId])
  @@index([operatorId])
  @@index([shiftId])
  @@index([startTime])
  @@index([machineId, startTime])
}

model DowntimeReason {
  id                   String           @id @default(cuid())
  code                 String           @unique
  description          String
  nameTe               String?
  nameHi               String?
  category             DowntimeCategory
  createdAt            DateTime         @default(now())
  isActive             Boolean          @default(true)
  affectsOperatorScore Boolean          @default(true)
  downtimeLogs         DowntimeLog[]
}

model DowntimeLog {
  id                String          @id @default(cuid())
  machineId         String
  machine           Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  workOrderId       String?
  workOrder         WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  reasonId          String?
  reason            DowntimeReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  operatorId        String?
  operator          User?           @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  startTime         DateTime
  endTime           DateTime?
  durationMinutes   Float?
  notes             String?
  createdAt         DateTime        @default(now())
  status            LogStatus       @default(DRAFT)
  adjustmentHistory Json?

  @@index([machineId])
  @@index([workOrderId])
  @@index([reasonId])
  @@index([startTime])
  @@index([machineId, startTime])
}

model DefectCode {
  id                 String              @id @default(cuid())
  code               String              @unique
  description        String
  nameTe             String?
  nameHi             String?
  severity           String              @default("MEDIUM")
  createdAt          DateTime            @default(now())
  isActive           Boolean             @default(true)
  qualityInspections QualityInspection[]
  ncrReports         NcrReport[]
}

model QualityMeasurement {
  id             String   @id @default(cuid())
  machineId      String
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  characteristic String
  value          Float
  lsl            Float
  usl            Float
  target         Float
  measuredAt     DateTime @default(now())

  @@index([machineId])
  @@index([characteristic])
  @@index([measuredAt])
}

model QualityInspection {
  id                String      @id @default(cuid())
  workOrderId       String
  workOrder         WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inspectorId       String?
  inspector         User?       @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  totalInspected    Int
  passed            Int
  failed            Int
  defectCodeId      String?
  defectCode        DefectCode? @relation(fields: [defectCodeId], references: [id], onDelete: SetNull)
  calibratedToolId  String?
  calibratedTool    CalibratedTool? @relation(fields: [calibratedToolId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime    @default(now())
  adjustmentHistory Json?

  @@index([workOrderId])
  @@index([inspectorId])
  @@index([defectCodeId])
  @@index([calibratedToolId])
}

model ImprovementProject {
  id                    String        @id @default(cuid())
  title                 String
  description           String?
  type                  ProjectType
  phase                 ProjectPhase  @default(DEFINE)
  status                ProjectStatus @default(OPEN)
  ownerName             String
  machineId             String?
  machine               Machine?      @relation(fields: [machineId], references: [id], onDelete: SetNull)
  expectedAnnualSavings Float?
  createdAt             DateTime      @default(now())
  completedAt           DateTime?
  updatedAt             DateTime      @updatedAt
  rcaRecord             RcaRecord?
  actionItems           ActionItem[]

  @@index([status])
  @@index([type])
  @@index([machineId])
}

model RcaRecord {
  id               String             @id @default(cuid())
  projectId        String             @unique
  project          ImprovementProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  problemStatement String?
  why1             String?
  why2             String?
  why3             String?
  why4             String?
  why5             String?
  rootCause        String?
  fishboneCategory FishboneCategory?
  updatedAt        DateTime           @updatedAt
}

model ActionItem {
  id          String             @id @default(cuid())
  projectId   String
  project     ImprovementProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  ownerName   String
  dueDate     DateTime
  status      ActionItemStatus   @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId])
}

model ShiftHandover {
  id                String   @id @default(cuid())
  date              DateTime
  shiftId           String
  shift             Shift    @relation(fields: [shiftId], references: [id])
  authorName        String
  machineId         String?
  machine           Machine? @relation(fields: [machineId], references: [id])
  productionNotes   String
  downtimeNotes     String
  safetyNotes       String
  nextShiftActions  String
  missReason        String?
  // P6 — incoming-supervisor acknowledgement + auto-attached context snapshots
  acknowledgedBy    String?
  acknowledgedAt    DateTime?
  openBreakdowns    Json? // snapshot: open breakdown maintenance jobs / downtime at write time
  openNcrs          Json? // snapshot: open NCRs at write time
  createdAt         DateTime @default(now())
  adjustmentHistory Json?

  @@index([shiftId])
  @@index([machineId])
  @@index([date])
}

// P7 — DPM board blockers: owner dept + due date; overdue → escalation candidate.
model DpmBlocker {
  id          String    @id @default(cuid())
  description String
  ownerDept   String
  dueDate     DateTime?
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  status      String    @default("OPEN") // OPEN | RESOLVED
  raisedBy    String
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// P8 — manager assign-override: lets a WO appear in an operator's My Queue
// even when their certs don't cover the op machine.
model AssignmentOverride {
  id          String    @id @default(cuid())
  workOrderId String
  operatorId  String
  machineId   String?
  assignedBy  String
  reason      String
  createdAt   DateTime  @default(now())

  @@index([operatorId])
  @@index([workOrderId])
}

// P9 — overtime requests: floor request → manager approve → payroll OT.
model OvertimeRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  hours          Float
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedByName String?
  approvedAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  details    String
  at         DateTime @default(now())

  @@index([at])
  @@index([action])
  @@index([entityType])
  @@index([action, at])
  @@index([action, entityType, at])
}

// P18 — S&OP Lite: decisions (OT / outsource / extra shift) auto-create HR OT requests or capacity windows
enum SopDecisionType {
  OVERTIME
  OUTSOURCE
  EXTRA_SHIFT
}

enum SopDecisionStatus {
  OPEN
  EXECUTED
  CANCELLED
}

model SopDecision {
  id             String           @id @default(cuid())
  decisionNumber String           @unique
  weekStart      DateTime
  decisionType   SopDecisionType
  gapHours       Float // hours shortfall that triggered this decision
  requiredHours  Float // extra hours planned
  notes          String?
  status         SopDecisionStatus @default(OPEN)
  outcome        Json? // [{ type: "OT_REQUEST" | "WINDOW", refId, label }]
  createdByName  String
  createdAt      DateTime         @default(now())

  @@index([weekStart])
  @@index([status])
}

// P18 — reserved capacity on a machine: OUTSOURCE (work sent out, machine blocked) or MAINTENANCE (planned window)
enum CapacityWindowType {
  OUTSOURCE
  MAINTENANCE
}

model CapacityWindow {
  id            String             @id @default(cuid())
  machineId     String
  machine       Machine            @relation(fields: [machineId], references: [id], onDelete: Cascade)
  windowType    CapacityWindowType
  title         String
  from          DateTime
  to            DateTime
  hours         Float?
  reason        String?
  createdByName String
  createdAt     DateTime           @default(now())

  @@index([machineId])
  @@index([from])
}

// P19 — Price Revision Register: contractual annual increases, manager-approved lists become quote defaults
model PriceRevision {
  id                String   @id @default(cuid())
  revisionNumber    String   @unique
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice          Float
  newPrice          Float
  increasePct       Float
  effectiveDate     DateTime
  reason            String?
  status            String   @default("DRAFT") // DRAFT | APPROVED | REJECTED
  approvedByName    String?
  approvedAt        DateTime?
  createdByName     String
  createdAt         DateTime @default(now())
  adjustmentHistory Json?

  @@index([productId])
  @@index([status])
  @@index([effectiveDate])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

model Assignment {
  id         String           @id @default(cuid())
  machineId  String
  machine    Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  operatorId String
  operator   User             @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  validFrom  DateTime         @default(now())
  validTo    DateTime?
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([machineId])
  @@index([operatorId])
  @@index([shiftId])
}

enum AttendanceStatus {
  PRESENT
  LATE
}

model AttendanceLog {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId           String
  shift             Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  clockIn           DateTime         @default(now())
  clockOut          DateTime?
  status            AttendanceStatus @default(PRESENT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  adjustmentHistory Json?

  @@index([userId])
  @@index([shiftId])
  @@index([clockIn])
  @@index([userId, clockOut])
}

model AttendanceDevice {
  id           String   @id @default(cuid())
  name         String
  type         String
  endpointKey  String   @unique
  config       Json?
  lastSeen     DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([endpointKey])
  @@index([isActive])
}

model RoutineStep {
  id        String            @id @default(cuid())
  // Role is a plain name string (OPERATOR | SUPERVISOR | ADMIN), not an FK —
  // the routines API, seed and admin tab all filter by role name.
  role      String            @default("OPERATOR")
  seq       Int
  title     String
  target    String
  timeLabel String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  progress  RoutineProgress[]

  @@unique([role, seq])
  @@index([role])
}

model RoutineProgress {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId String
  step   RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  date   DateTime
  doneAt DateTime    @default(now())

  @@unique([userId, date, stepId])
  @@index([userId])
  @@index([date])
}

enum FiveSCategory {
  SORT
  SET_IN_ORDER
  SHINE
  STANDARDIZE
  SUSTAIN
}

model FiveSItem {
  id        String            @id @default(cuid())
  category  FiveSCategory
  seq       Int
  text      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  scores    FiveSAuditScore[]

  @@index([category, seq])
}

model FiveSAudit {
  id          String            @id @default(cuid())
  area        String
  auditorName String
  date        DateTime          @default(now())
  totalPct    Float
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  scores      FiveSAuditScore[]

  @@index([area])
  @@index([date])
}

model FiveSAuditScore {
  id      String     @id @default(cuid())
  auditId String
  audit   FiveSAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemId  String
  item    FiveSItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  score   Int

  @@unique([auditId, itemId])
  @@index([auditId])
  @@index([itemId])
}

model ShiftCount {
  id                String   @id @default(cuid())
  machineId         String
  machine           Machine  @relation(fields: [machineId], references: [id])
  fromShiftId       String
  fromShift         Shift    @relation("FromShiftCount", fields: [fromShiftId], references: [id])
  toShiftId         String?
  toShift           Shift?   @relation("ToShiftCount", fields: [toShiftId], references: [id])
  outgoingUserId    String
  outgoingUser      User     @relation("OutgoingUserCount", fields: [outgoingUserId], references: [id])
  incomingUserId    String?
  incomingUser      User?    @relation("IncomingUserCount", fields: [incomingUserId], references: [id])
  outCount          Int
  inCount           Int?
  finalCount        Int?
  status            String   @default("PENDING") // PENDING | AGREED | DISPUTED | RESOLVED
  note              String?
  at                DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  adjustmentHistory Json?

  @@index([machineId])
  @@index([fromShiftId])
  @@index([status])
  @@index([at])
}

model ScrapQuarantine {
  id                String        @id @default(cuid())
  workOrderId       String
  workOrder         WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  quantity          Int
  defectCode        String
  loggedBy          String        @default("Operator")
  status            String        @default("PENDING") // PENDING | SCRAPPED | REWORK | VENDOR_RETURN
  dispositionNotes  String?
  costEstimate      Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reworkOrders      ReworkOrder[]
  adjustmentHistory Json?
  ncrReport         NcrReport?

  @@index([workOrderId])
  @@index([status])
  @@index([createdAt])
}

model ReworkOrder {
  id                String          @id @default(cuid())
  quarantineId      String
  quarantine        ScrapQuarantine @relation(fields: [quarantineId], references: [id], onDelete: Cascade)
  targetMachineId   String
  targetMachine     Machine         @relation(fields: [targetMachineId], references: [id], onDelete: Cascade)
  routingSteps      String // e.g. "Surface Grinding -> QC Re-inspection"
  extraLaborHours   Float           @default(1.0)
  status            String          @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  adjustmentHistory Json?

  @@index([quarantineId])
  @@index([targetMachineId])
}

model Tool {
  id                String   @id @default(cuid())
  toolCode          String   @unique
  name              String
  maxLifeCycles     Int
  currentCycles     Int      @default(0)
  warningThreshold  Float    @default(85.0)
  status            String   @default("ACTIVE") // ACTIVE | WARNING | MAINTENANCE | RETIRED
  assignedMachineId String?
  assignedMachine   Machine? @relation(fields: [assignedMachineId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  adjustmentHistory Json?

  @@index([toolCode])
  @@index([status])
}

model Idea {
  id                String    @id @default(cuid())
  title             String
  category          String    @default("SAFETY")
  description       String
  submitter         String    @default("Operator")
  submittedBy       String?
  votes             Int       @default(0)
  upvotes           Int?
  status            String    @default("SUBMITTED") // SUBMITTED | IN_REVIEW | IMPLEMENTED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  adjustmentHistory Json?

  @@index([status])
}

model SafetyIncident {
  id                String    @id @default(cuid())
  type              String // NEAR_MISS | HAZARD | PPE_VIOLATION | INCIDENT
  severity          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  location          String
  description       String
  reportedBy        String    @default("Operator")
  reportedAt        DateTime  @default(now())
  status            String    @default("OPEN") // OPEN | IN_INVESTIGATION | CLOSED
  capaOwner         String?
  dueDate           DateTime?
  capaDueDate       DateTime?
  rootCause         String?
  fiveWhyReason     String?
  actionTaken       String?
  closedAt          DateTime?
  closedBy          String?
  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @updatedAt
  adjustmentHistory Json?
  machineId         String?
  machine           Machine?  @relation(fields: [machineId], references: [id])

  @@index([type])
  @@index([status])
  @@index([severity])
}

model SafetyAudit {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  auditorName String
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id])
  score       Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([machineId])
}

model Certification {
  id          String    @id @default(cuid())
  userId      String
  machineId   String
  certifiedBy String
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  isActive    Boolean   @default(true)
  notes       String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId])
  @@index([machineId])
}

model Supplier {
  id                String            @id @default(cuid())
  name              String
  code              String?
  gstin             String? // GST registration number (import wizard + Tally payables)
  state             String?
  contactPerson     String?
  email             String?
  phone             String?
  contactPhone      String?
  rating            Int               @default(5)
  leadTimeDays      Int               @default(7)
  defaultLeadDays   Int?
  paymentTerms      String            @default("NET30")
  isApproved        Boolean           @default(true)
  isActive          Boolean?          @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  rawMaterials      RawMaterial[]
  purchaseOrders    PurchaseOrder[]
  payments          SupplierPayment[]
  materialCerts     MaterialCert[]
  grns              GoodsReceiptNote[]
  supplierInvoices  SupplierInvoice[]
  calLabRequisitions CalLabRequisition[]
  calLabRatings     CalLabVendorRating[]
  supplierNcrs      NcrReport[]
  adjustmentHistory Json?
  comparativeQuotes ComparativeQuote[]
  rateContracts     RateContract[]
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  code          String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  gstin         String?
  type            CustomerType   @default(DOMESTIC)
  pan             String?
  currency        String         @default("INR")
  creditLimit     Float          @default(0) // 0 = no explicit limit
  creditDays      Int            @default(30)
  billingAddress  String?
  shippingAddress String?
  notes           String?
  createdBy       String?
  contacts        CustomerContact[]
  salesOrders     SalesOrder[]
  paymentTerms  String   @default("NET30") // M16 — terms-vs-exposure baseline (NET15/30/45/60/ADVANCE/CUSTOM)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RawMaterial {
  id                String                 @id @default(cuid())
  sku               String                 @unique
  name              String
  unit              String                 @default("pcs")
  currentStock      Float                  @default(0.0)
  minStock          Float                  @default(0.0)
  unitCost          Float                  @default(0.0)
  materialClass     String?                @default("C") // M6 IQC AQL — A/B/C sampling class (looked up in AqlPlan)
  plantId               String?
  plant             Plant?                 @relation(fields: [plantId], references: [id], onDelete: Cascade)
  supplierId        String?
  supplier          Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  isActive          Boolean                @default(true)
  transactions      InventoryTransaction[]
  purchaseOrders    PurchaseOrder[]
  bomLines          BomLine[]
  materialCerts     MaterialCert[]
  grns              GoodsReceiptNote[]
  cycleCountLines   CycleCountLine[] // P15
  materialIssueSlips MaterialIssueSlip[] // P16
  adjustmentHistory Json?
  binLocations      BinLocation[]
  writeOffRequests  WriteOffRequest[]
  comparativeStatements ComparativeStatement[]
  rateContracts     RateContract[]

  poLines           PurchaseOrderLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@index([sku])
  @@index([isActive])
  @@index([supplierId])
  @@index([plantId])
}

model InventoryTransaction {
  id                String        @id @default(cuid())
  rawMaterialId     String
  rawMaterial       RawMaterial   @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  type              String // IN | OUT | ADJUST
  qty               Float
  unitCost          Float?
  plantId               String?
  plant             Plant?        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  batchNo           String?
  reference         String? // e.g. "PO-102" or "WO-2026-003"
  workOrderId       String?
  workOrder         WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  actorName         String        @default("Storekeeper")
  at                DateTime      @default(now())
  adjustmentHistory Json?
  materialCert      MaterialCert?

  @@index([rawMaterialId])
  @@index([type])
  @@index([workOrderId])
  @@index([at])
  @@index([rawMaterialId, type])
}

enum POStatus {
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String            @id @default(cuid())
  poNumber          String            @unique
  supplierId        String
  supplier          Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial       @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  qty               Float
  unitCost          Float
  status            POStatus          @default(ORDERED)
  expectedDate      DateTime?
  receivedQty       Float             @default(0)
  receivedAt        DateTime?
  createdBy         String            @default("Admin")
  approvalStatus    String            @default("APPROVED") // APPROVED | PENDING_MANAGER | PENDING_OWNER | REJECTED
  approvalLevel     String?           // MANAGER | OWNER — level required when over threshold
  managerApprovedBy String?
  managerApprovedAt DateTime?
  ownerApprovedBy   String?
  ownerApprovedAt   DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  adjustmentHistory Json?
  payments          SupplierPayment[]
  grns              GoodsReceiptNote[]
  supplierInvoices  SupplierInvoice[]

  lines             PurchaseOrderLine[]

  @@index([supplierId])
  @@index([rawMaterialId])
  @@index([status])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id            String            @id @default(cuid())
  poId          String
  po            PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial       @relation(fields: [rawMaterialId], references: [id])
  lineNo        Int               @default(1)
  qty           Float
  unitCost      Float
  receivedQty   Float             @default(0)
  createdAt     DateTime          @default(now())

  grns          GoodsReceiptNote[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@index([poId])
  @@index([rawMaterialId])
}


model BinLocation {
  id            String       @id @default(cuid())
  warehouse     String
  zone          String
  location      String // e.g. "A-03-2" (aisle-rack-level)
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  qty           Float        @default(0)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([warehouse])
  @@index([zone])
  @@index([rawMaterialId])
}

model WriteOffRequest {
  id            String       @id @default(cuid())
  requestNumber String       @unique
  rawMaterialId String
  rawMaterial   RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  qty           Float
  unitValue     Float        @default(0)
  reason        String
  status        String       @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy   String
  requestedAt   DateTime     @default(now())
  decidedBy     String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([rawMaterialId])
}

model ComparativeStatement {
  id              String              @id @default(cuid())
  statementNumber String              @unique
  rawMaterialId   String
  rawMaterial     RawMaterial         @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  qty             Float
  requiredBy      DateTime?
  status          String              @default("OPEN") // OPEN | AWARDED | CLOSED
  awardedQuoteId  String?             @unique
  awardedQuote    ComparativeQuote?   @relation("AwardedQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)
  createdBy       String              @default("Admin")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  quotes          ComparativeQuote[]

  @@index([status])
  @@index([rawMaterialId])
}

model ComparativeQuote {
  id           String               @id @default(cuid())
  statementId  String
  statement    ComparativeStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unitRate     Float
  leadDays     Int                  @default(7)
  paymentTerms String?              @default("NET30")
  notes        String?
  createdAt    DateTime             @default(now())
  awardedStatement ComparativeStatement? @relation("AwardedQuote")

  @@index([statementId])
  @@index([supplierId])
}

model RateContract {
  id             String       @id @default(cuid())
  contractNumber String       @unique
  rawMaterialId  String
  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rate           Float
  validFrom      DateTime     @default(now())
  validTo        DateTime?
  status         String       @default("ACTIVE") // ACTIVE | EXPIRED | ARCHIVED
  notes          String?
  createdBy      String       @default("Admin")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([rawMaterialId])
  @@index([supplierId])
  @@index([status])
}

model FreightVendor {
  id            String             @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  city          String?
  lanes         String? // e.g. "Chennai–Pune; Delhi–Mumbai"
  rating        Int                @default(5) // 1-5
  isApproved    Boolean?           @default(true)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  dispatches    FreightDispatch[]
}

model FreightDispatch {
  id             String        @id @default(cuid())
  dispatchNumber String        @unique
  vendorId       String
  vendor         FreightVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reference      String? // WO / GRN / gate-pass reference
  route          String?
  vehicleNumber  String?
  pickupDate     DateTime?
  promisedDate   DateTime
  actualDate     DateTime?
  charges        Float         @default(0)
  status         String        @default("SCHEDULED") // SCHEDULED | IN_TRANSIT | DELIVERED | DELAYED | CANCELLED
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([promisedDate])
}

model BomLine {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  qtyPerUnit        Float
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  adjustmentHistory Json?

  @@unique([productId, rawMaterialId])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([createdAt])
}

enum DocumentStatus {
  CURRENT
  ARCHIVED
}

model Document {
  id                String         @id @default(cuid())
  title             String
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  operationId       String?
  operation         Operation?     @relation(fields: [operationId], references: [id], onDelete: SetNull)
  version           Int            @default(1)
  mimeType          String
  fileData          Bytes
  sizeKb            Int
  status            DocumentStatus @default(CURRENT)
  uploadedBy        String         @default("Admin")
