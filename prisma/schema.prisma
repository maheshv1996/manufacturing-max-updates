}

model CustomerScorecard {
  id             String   @id @default(cuid())
  scorecardNumber String  @unique // SCC-YYYY-NNN
  customerName   String
  period         String   // YYYY-MM - scorecard month
  ppm            Float?   // our PPM as scored by the customer
  otpPct         Float?   // our on-time-performance % as scored
  score          Float?   // overall customer score 0-100
  receivedAt     DateTime @default(now())
  fileRef        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerName])
  @@index([period])
}

enum ItAssetType {
  LAPTOP
  DESKTOP
  MONITOR
  MOBILE
  PRINTER
  SERVER
  NETWORK
  UPS
  OTHER
}

model ItAsset {
  id           String     @id @default(cuid())
  assetCode    String     @unique // ITA-YYYY-NNN
  name         String
  assetType    ItAssetType
  serialNumber String?
  assignedToId String?
  assignedTo   User?      @relation("ItAssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  status       String     @default("IN_STOCK") // IN_STOCK | ASSIGNED | IN_MAINTENANCE | RETIRED
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assetType])
  @@index([status])
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ItTicket {
  id           String        @id @default(cuid())
  ticketNumber String        @unique // ITK-YYYY-NNN
  title        String
  category     TicketCategory
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  raisedById   String?
  raisedBy     User?          @relation("TicketRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  raisedAt     DateTime       @default(now())
  slaDueAt     DateTime       // raisedAt + priority SLA hours
  resolvedAt   DateTime?
  closedAt     DateTime?
  resolution   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([priority])
  @@index([slaDueAt])
}


model PackagingScanLog {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  ean         String
  operatorId  String?
  operator    User?     @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  shiftId     String?
  shift       Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  result      String    @default("SUCCESS") // SUCCESS | UNKNOWN_EAN | OVERPACK
  quantity    Int       @default(1)
  timestamp   DateTime  @default(now())
  notes       String?

  @@index([workOrderId, timestamp])
  @@index([timestamp])
}

// ===== PR1 — atomicity & idempotency infrastructure =====

model SequenceCounter {
  id        String   @id // e.g. PO-2026, GRN-2026, NCR-SUP-2026
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  clientId  String   @unique
  endpoint  String?
  createdAt DateTime @default(now())
  response  Json?

  @@index([createdAt])
}

// ===== Infinite — custom entities / fields / values =====
// Generic low-code layer: any plant can invent `Titanium Blisk Cell` with N fields
// and a Flow `if wear>90% → NCR + webhook` without a deploy. Values are JSON-typed
// and validated via zod generated from CustomField at runtime.

model CustomEntity {
  id          String       @id @default(cuid())
  slug        String       @unique // e.g. titanium_blisk_cell (derived from title)
  title       String
  description String?
  icon        String?      // lucide icon name, e.g. Layers
  colorTone   String?      // amber|emerald|violet|blue|cyan
  isActive    Boolean      @default(true)
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  fields      CustomField[]
  records     CustomRecord[]

  @@index([isActive])
}

model CustomField {
  id           String       @id @default(cuid())
  entityId     String
  entity       CustomEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  key          String       // e.g. blisk_serial, coating_microns (slug)
  label        String
  fieldType    String       // text|number|date|select|boolean
  required     Boolean      @default(false)
  options      Json?        // for select: ["PVD","CVD"]
  placeholder  String?
  defaultValue Json?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@unique([entityId, key])
  @@index([entityId])
}

// ---------------------------------------------------------------------------
// GL / Double-Entry Accounting Core (finance accounting)
// ---------------------------------------------------------------------------
enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum GlNormalBalance {
  DEBIT
  CREDIT
}

enum GlAccountGroup {
  // Assets
  CURRENT_ASSET
  FIXED_ASSET
  INTANGIBLE_ASSET
  // Liabilities
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  // Equity
  CAPITAL
  RESERVES
  RETAINED_EARNINGS
  // Revenue
  SALES_REVENUE
  OTHER_REVENUE
  // Expenses
  DIRECT_EXPENSE
  OPERATING_EXPENSE
  FINANCE_EXPENSE
  TAX_EXPENSE
}

model GlAccount {
  id            String          @id @default(cuid())
  code          String          @unique // e.g. 1010 — chart-of-accounts code
  name          String
  type          GlAccountType
  group         GlAccountGroup?
  normalBalance GlNormalBalance @default(DEBIT)
  description   String?
  isActive      Boolean         @default(true)
  isSystem      Boolean         @default(false) // seeded defaults — never hard-deleted
  createdBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  journalLines  JournalLine[]

  @@index([type])
  @@index([group])
  @@index([isActive])
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSource {
  MANUAL
  VOUCHER
  INVOICE
  PAYMENT
  DEPRECIATION
  SYSTEM
}

model JournalEntry {
  id           String             @id @default(cuid())
  entryNumber  String             @unique // JE-YYYY-NNNN via SequenceCounter
  date         DateTime
  period       String?            // "YYYY-MM" — fiscal month the entry posts into
  memo         String
  status       JournalEntryStatus @default(DRAFT)
  source       JournalSource      @default(MANUAL)
  sourceId     String?            // originating doc (voucher / invoice id) when applicable
  totalDebit   Float              @default(0)
  totalCredit  Float              @default(0)
  createdBy    String
  postedBy     String?
  postedAt     DateTime?
  reversedById String?            @unique // points at the reversal entry, if this entry was reversed
  reversal     JournalEntry?      @relation("Reversal", fields: [reversedById], references: [id], onDelete: SetNull)
  reversals    JournalEntry[]     @relation("Reversal")
  reversalOfId String?            // set on the reversal entry, pointing at the original
  reversalOf   JournalEntry?      @relation("ReversalOf", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversalsOf  JournalEntry[]     @relation("ReversalOf")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        JournalLine[]

  @@index([date])
  @@index([period])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model JournalLine {
  id        String      @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   GlAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Float       @default(0)
  credit    Float       @default(0)
  reference String?     // source doc number (invoice / voucher / PO)
  narration String?
  createdAt DateTime    @default(now())

  @@index([accountId])
  @@index([entryId])
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model FiscalPeriod {
  id        String             @id @default(cuid())
  code      String             @unique // e.g. "2026-04" or "FY2026-27"
  label     String?
  startDate DateTime
  endDate   DateTime
  status    FiscalPeriodStatus @default(OPEN)
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime           @default(now())

  @@index([status])
  @@index([startDate])
}

// ---------------------------------------------------------------------------
// HR Master — Employee (PAN/UAN/DOJ/bank etc.) + richer payslip fields
// ---------------------------------------------------------------------------
enum EmployeeStatus {
  ACTIVE
  ON_HOLD
  EXITED
}

model Employee {
  id                String         @id @default(cuid())
  employeeNumber    String         @unique // join key: User.employeeNumber / SalaryStructure.employeeCode
  name              String
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  designation       String?
  department        String?
  doj               DateTime?
  dob               DateTime?
  gender            String?
  phone             String?
  email             String?
  panNumber         String?
  aadhaarNumber     String?
  pfUan             String?
  esiNumber         String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  address           String?
  bloodGroup        String?
  emergencyContact  String?
  status            EmployeeStatus @default(ACTIVE)
  exitDate          DateTime?
  exitReason        String?
  createdBy         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([department])
  @@index([designation])
  @@index([doj])
}

// ---------------------------------------------------------------------------
// CRM / Sales — Customer master + SalesOrders with line items
// ---------------------------------------------------------------------------
enum CustomerType {
  DOMESTIC
  EXPORT
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_DISPATCHED
  DISPATCHED
  INVOICED
  CANCELLED
}

model SalesOrder {
  id                String            @id @default(cuid())
  orderNumber       String            @unique // SO-YYYY-NNNN via SequenceCounter
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName      String            // denormalized snapshot
  orderDate         DateTime          @default(now())
  expectedDelivery  DateTime?
  poReference       String?           // customer purchase order ref
  paymentTerms      String?
  currency          String            @default("INR")
  status            SalesOrderStatus  @default(DRAFT)
  sourceQuotationId String?           // plain ref — created from a quotation
  totalValue        Float             @default(0) // Σ line amounts (before tax)
  totalDiscount     Float             @default(0)
  totalTax          Float             @default(0)
  grandTotal        Float             @default(0) // value − discount + tax
  notes             String?
  createdBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lines             SalesOrderLine[]
  invoices          Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model SalesOrderLine {
  id            String      @id @default(cuid())
  salesOrderId  String
  salesOrder    SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode   String?     // snapshot for legacy/free-form lines
  productName   String
  quantity      Float
  unitPrice     Float
  discountPct   Float       @default(0)
  taxPct        Float       @default(0) // GST line rate
  amount        Float       @default(0) // qty × unitPrice
  discountAmt   Float       @default(0)
  taxAmt        Float       @default(0)
  total         Float       @default(0) // amount − discount + tax
  scheduledDate DateTime?
  dispatchedQty Float       @default(0)
  invoicedQty   Float       @default(0)
  createdAt     DateTime    @default(now())

  @@index([salesOrderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Org-wide services — Announcements, Visitor log, Vehicle register, Insurance
// ---------------------------------------------------------------------------
model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  category  String    @default("GENERAL") // GENERAL | HR | SAFETY | QUALITY | MAINTENANCE | EVENT | EMERGENCY
  priority  String    @default("NORMAL")  // NORMAL | IMPORTANT | URGENT
  pinned    Boolean   @default(false)
  active    Boolean   @default(true)
  author    String?
  publishAt DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
  @@index([category])
  @@index([publishAt])
}

model VisitorLog {
  id            String    @id @default(cuid())
  visitorName   String
  company       String?
  phone         String?
  purpose       String?
  hostName      String?
  vehicleNumber String?
  idProofType   String?
  idProofNumber String?
  badgeNumber   String?
  checkInAt     DateTime  @default(now())
  checkOutAt    DateTime?
  status        String    @default("IN_SITE") // EXPECTED | IN_SITE | CHECKED_OUT
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([checkInAt])
}

model Vehicle {
  id                  String   @id @default(cuid())
  registrationNumber  String   @unique
  make                String?
  model               String?
  type                String   @default("FOUR_WHEELER") // TWO_WHEELER | CAR | VAN | TRUCK | BUS | FORKLIFT | OTHER
  year                Int?
  fuelType            String?
  capacity            String?
  assignedDriver      String?
  rcExpiryDate        DateTime?
  insuranceExpiryDate DateTime?
  fitnessExpiryDate   DateTime?
  permitExpiryDate    DateTime?
  status              String   @default("ACTIVE") // ACTIVE | IN_SERVICE | OUT_OF_SERVICE | SOLD
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
}

model InsurancePolicy {
  id               String   @id @default(cuid())
  policyNumber     String
  insurer          String?
  policyType       String   @default("OTHER") // ASSET | VEHICLE | FIRE | LIABILITY | GROUP_HEALTH | GROUP_LIFE | KEYMAN | MARINE | OTHER
  coveredAsset     String?  // vehicle reg / asset tag / employee group
  sumInsured       Float    @default(0)
  premium          Float    @default(0)
  premiumFrequency String   @default("YEARLY") // MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY | ONE_TIME
  startDate        DateTime?
  endDate          DateTime?
  renewalDate      DateTime?
  status           String   @default("ACTIVE") // ACTIVE | EXPIRING | EXPIRED | CANCELLED
  notes            String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([renewalDate])
}

model CustomRecord {
  id        String       @id @default(cuid())
  entityId  String
  entity    CustomEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  values    Json         // { blisk_serial: "BLK-001", coating_microns: 12.5 }
  createdBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([entityId])
  @@index([createdAt])
}
