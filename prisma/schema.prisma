enum HazWasteCategory {
  HAZARDOUS
  NON_HAZARDOUS
}

enum ManifestStatus {
  GENERATED
  IN_TRANSIT
  DISPOSED
}

model HazWasteManifest {
  id             String           @id @default(cuid())
  manifestNumber String           @unique // MHW-YYYY-NNN
