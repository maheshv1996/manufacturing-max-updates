enum DataPackageStatus {
  DRAFT
  RELEASED
}

model DataPackage {
  id            String            @id @default(cuid())
  packageNumber String            @unique
  workOrderId   String
  workOrder     WorkOrder         @relation(fields: [workOrderId], references: [id])
  status        DataPackageStatus @default(DRAFT)
  snapshot      Json?
  releasedBy    String?
  releasedAt    DateTime?
  createdBy     String
  createdAt     DateTime          @default(now())

  @@index([workOrderId])
  @@index([packageNumber])
}

enum EcoStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
  REJECTED
}

enum EcoEffectivityType {
  DATE
  SERIAL
}

enum EcoAction {
  REPLACE
  ADD
  REMOVE
}

enum EcoEntityType {
  BOM
  DRAWING
  ROUTING
}

model Eco {
  id              String             @id @default(cuid())
  ecoNumber       String             @unique
  title           String
  description     String
  status          EcoStatus          @default(DRAFT)
  effectivityType EcoEffectivityType @default(DATE)
  effectivityValue String
  raisedBy        String
  approvedBy      String?
  approvedAt      DateTime?
  implementedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           EcoItem[]
}

model EcoItem {
  id         String        @id @default(cuid())
  ecoId      String
  eco        Eco           @relation(fields: [ecoId], references: [id], onDelete: Cascade)
  entityType EcoEntityType
  productId  String
  action     EcoAction
  oldData    Json?
  newData    Json?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ecoId])
}


model TestCampaign {
  id              String             @id @default(cuid())
  campaignNumber  String             @unique
  workOrderId     String
  workOrder       WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  title           String
  status          TestCampaignStatus @default(PLANNED)
  testCostRupees  Float              @default(0)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  records         TestRecord[]
  
  @@index([workOrderId])
}

model TestRecord {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parameterName String
  unit          String?
  target        Float?
  min           Float?
  max           Float?
  actual        Float?
  result        TestResult   @default(PENDING)
  testedBy      String?
  testedAt      DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@index([campaignId])
}

// ----------------------------------------------------------------
// Corporate Services & Compliance (Departments 8-13)
// ----------------------------------------------------------------

model StatutoryContribution {
  id           String   @id @default(cuid())
  employeeName String
  employeeCode String?
  month        String // "YYYY-MM"
  pfNumber     String?
  esiNumber    String?
  pfWage       Float    @default(0)
  pfEmployee   Float    @default(0)
  pfEmployer   Float    @default(0)
  esiWage      Float    @default(0)
  esiEmployee  Float    @default(0)
  esiEmployer  Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([month])
  @@index([employeeCode])
}

model HealthCheckRecord {
  id            String   @id @default(cuid())
  employeeName  String
  employeeCode  String?
  checkDate     DateTime @default(now())
  bloodPressure String?
  vision        String?
  audiometry    String?
  weightKg      Float?
  fitnessStatus String   @default("FIT") // FIT | FIT_WITH_NOTES | UNFIT
  notes         String?
  conductedBy   String?
  createdAt     DateTime @default(now())

  @@index([checkDate])
}

enum EnvironmentalComplianceType {
  WASTE
  EMISSION
  EFFLUENT
  PERMIT
  OTHER
}

model EnvironmentalRecord {
  id               String                        @id @default(cuid())
  recordType       EnvironmentalComplianceType
  title            String
  description      String?
  permitNumber     String?
  complianceStatus String                        @default("COMPLIANT") // COMPLIANT | PARTIAL | NON_COMPLIANT
  recordedAt       DateTime                      @default(now())
  dueDate          DateTime?
  owner            String?
  createdAt        DateTime                      @default(now())

  @@index([recordType])
  @@index([complianceStatus])
}

model FireDrillRecord {
  id           String    @id @default(cuid())
  drillDate    DateTime  @default(now())
  location     String
  participants Int       @default(0)
  durationMin  Int?
  passed       Boolean   @default(true)
  notes        String?
  conductedBy  String?
  createdAt    DateTime  @default(now())

  @@index([drillDate])
}

enum ShipmentMode {
  AIR
  SEA
  ROAD
  RAIL
}

enum Incoterm {
  EXW
  FOB
  CIF
  CIP
  DAP
  DDP
  OTHER
}

model EximShipment {
  id             String       @id @default(cuid())
  shipmentNumber String       @unique
  shipmentType   String       @default("EXPORT") // EXPORT | IMPORT
  mode           ShipmentMode @default(AIR)
  incoterm       Incoterm     @default(FOB)
  port           String
  invoiceNumber  String?
  workOrderId    String?
  customerName   String?
  customsValue   Float        @default(0)
  currency       String       @default("USD")
  shipmentDate   DateTime     @default(now())
  status         String       @default("BOOKED") // BOOKED | IN_TRANSIT | CLEARED | DELIVERED
  notes          String?
  vesselName     String?
  voyageNo       String?
  blNumber       String?
  bookingDate    DateTime?
  sailingDate    DateTime?
  customsClearDate DateTime?
  arrivalDate    DateTime?
  docCi          Boolean      @default(false) // Commercial Invoice
  docPl          Boolean      @default(false) // Packing List
  docCoO         Boolean      @default(false) // Certificate of Origin
  docBl          Boolean      @default(false) // Bill of Lading
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([shipmentNumber])
  @@index([shipmentDate])
}

model InvestorUpdate {
  id           String   @id @default(cuid())
  quarter      String // e.g. "Q1 FY26"
  headline     String
  revenue      Float    @default(0)
  ebitda       Float    @default(0)
  netProfit    Float    @default(0)
  ordersBooked Float    @default(0)
  summary      String?
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([quarter])
}

model BudgetLine {
  id         String   @id @default(cuid())
  fiscalYear String
  department String
  category   String
  allocated  Float    @default(0)
  spent      Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fiscalYear])
  @@index([department])
}

enum TreasuryType {
  INFLOW
  OUTFLOW
}

model TreasuryTransaction {
  id        String              @id @default(cuid())
  date      DateTime            @default(now())
  type      TreasuryType
  account   String              @default("Main")
  amount    Float
  reference String?
  category  String?
  notes     String?
  createdAt DateTime            @default(now())

  bankMatches BankStatementEntry[]

  @@index([date])
}

enum UtilityType {
  POWER
  COMPRESSED_AIR
  HVAC
  WATER
  GAS
}

model UtilityReading {
  id          String      @id @default(cuid())
  utilityType UtilityType
  meterName   String?
  reading     Float
  unit        String      @default("kWh")
  cost        Float       @default(0)
  readAt      DateTime    @default(now())
  notes       String?
  createdAt   DateTime    @default(now())

  @@index([utilityType])
  @@index([readAt])
}

model SparePart {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  machineCode  String?
  currentQty   Float    @default(0)
  minQty       Float    @default(0)
  unitCost     Float    @default(0)
  supplierName String?
  location     String?
  notes        String?
  abcClass     String?  // M27 - A | B | C (auto-classified, manual override)
  vedClass     String?  // M27 - V | E | D (vital/essential/desirable)
  leadTimeDays Int      @default(15) // M27 - procurement lead time for reorder point
  avgDailyUsage Float   @default(0) // M27 - average daily consumption (for ABC + reorder)
  reorderPoint Float    @default(0) // M27 - leadTimeDays x avgDailyUsage (auto)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  kitItems     SpareKitItem[] // M27 - kit memberships

  @@index([sku])
  @@index([machineCode])
}

model Contract {
  id             String    @id @default(cuid())
  contractNumber String    @unique
  customerName   String
  projectId      String?
  title          String?
  value          Float     @default(0)
  currency       String    @default("INR")
  startDate      DateTime
  endDate        DateTime?
  poReference    String?
  status         String    @default("ACTIVE") // DRAFT | ACTIVE | COMPLETED | CLOSED
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerName])
  @@index([status])
}

enum InfrastructureType {
  SERVER
  NETWORK
  WORKSTATION
  PRINTER
  UPS
  OTHER
}

model InfrastructureAsset {
  id            String              @id @default(cuid())
  assetType     InfrastructureType
  name          String
  ipAddress     String?
  location      String?
  status        String              @default("OPERATIONAL") // OPERATIONAL | DEGRADED | OFFLINE
  warrantyUntil DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([assetType])
  @@index([status])
}

model BackupJob {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  sizeMb      Float?
  target      String    @default("PostgreSQL")
  notes       String?
  createdAt   DateTime  @default(now())
  restoreDrills RestoreDrill[]

  @@index([startedAt])
}

model QmsAudit {
  id            String    @id @default(cuid())
  auditNumber   String    @unique
  title         String
  standard      String    @default("AS9100") // ISO9001 | AS9100 | ISO14001 | OTHER
  auditType     String    @default("INTERNAL") // INTERNAL | CUSTOMER | SURVEILLANCE | EXTERNAL
  auditor       String?
  auditeeDept   String?
  scheduledDate DateTime  @default(now())
  completedAt   DateTime?
  status        String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  result        String?   // PASS | PASS_WITH_FINDINGS | FAIL
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  findings QmsAuditFinding[]

  @@index([status])
  @@index([standard])
}

model QmsAuditFinding {
  id               String    @id @default(cuid())
  auditId          String
  audit            QmsAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  clause           String
  description      String
  severity         String    @default("MINOR") // MINOR | MAJOR | CRITICAL
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  correctiveAction String?
  ncrId            String?
  ncr              NcrReport? @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  dueDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([auditId])
  @@index([status])
}

model MarketingCampaign {
  id        String    @id @default(cuid())
  name      String
  channel   String    @default("DIGITAL") // EMAIL | DIGITAL | TRADE_SHOW | PRINT | REFERRAL | OTHER
  budget    Float     @default(0)
  spent     Float     @default(0)
  status    String    @default("PLANNED") // PLANNED | ACTIVE | PAUSED | COMPLETED
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]

  @@index([status])
}

model SalaryStructure {
  id               String   @id @default(cuid())
  employeeName     String
  employeeCode     String   @unique
  designation      String?
  basicPay         Float    @default(0)
  hra              Float    @default(0)
  specialAllowance Float    @default(0)
  conveyance       Float    @default(0)
  otherAllowance   Float    @default(0)
  pfPercent        Float    @default(12)
  professionalTax  Float    @default(200)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payslips Payslip[]

  @@index([employeeCode])
}

model Payslip {
  id                String          @id @default(cuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  month             String // "YYYY-MM"
  grossPay          Float
  pfDeduction       Float
  ptDeduction       Float
  netPay            Float
  otHours           Float           @default(0)
  otPay             Float           @default(0)
  generatedAt       DateTime        @default(now())

  esiDeduction      Float           @default(0) // 0.75% of gross when gross <= 21000
  lopDays           Float           @default(0)
  lopDeduction      Float           @default(0) // (gross / 30) × lopDays
  bonus             Float           @default(0)
  arrears           Float           @default(0)

  @@unique([salaryStructureId, month])
  @@index([month])
}

model BankStatementEntry {
  id               String              @id @default(cuid())
  date             DateTime
  description      String
  amount           Float               // positive = inflow, negative = outflow
  balanceAfter     Float?
  matchedTreasuryId String?
  matchedTreasury  TreasuryTransaction? @relation(fields: [matchedTreasuryId], references: [id], onDelete: SetNull)
  matchStatus      String              @default("UNMATCHED") // UNMATCHED | MATCHED | MANUAL
  uploadBatch      String
  createdAt        DateTime            @default(now())

  @@index([matchedTreasuryId])
  @@index([uploadBatch])
}

model ComplianceDigestLog {
  id              String   @id @default(cuid())
  generatedAt     DateTime @default(now())
  recipientEmails String   @default("[]") // JSON array
  criticalCount   Int      @default(0)
  warningCount    Int      @default(0)
  payload         String?  // JSON snapshot of the flags
  status          String   @default("LOGGED") // LOGGED | EMAILED | FAILED

  @@index([generatedAt])
}

model NotificationRead {
  id             String   @id @default(cuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
}

model SupplierScorecard {
  id             String   @id @default(cuid())
  supplierId     String?
  supplierName   String
  period         String   // e.g. "Q1 FY27"
  onTimeDelivery Float    @default(0) // 0-100 %
  qualityPpm     Float    @default(0)
  costVariance   Float    @default(0) // % deviation (positive = over cost)
  responsiveness Int      @default(3) // 1-5
  overallScore   Float    @default(0) // computed: 35% OTD + 35% PPM + 15% cost + 15% responsiveness
  grade          String   @default("C") // A | B | C | D
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([period])
  @@index([supplierName])
}

model TimeStudy {
  id              String   @id @default(cuid())
  productSku      String?
  operationName   String
  department      String?
  standardTimeMin Float    @default(0) // SAM — standard allowed minutes
  measuredTimeMin Float?
  sampleSize      Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productSku])
}

model Fixture {
  id               String        @id @default(cuid())
  code             String        @unique
  name             String
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  machineId        String?
  machine          Machine?      @relation(fields: [machineId], references: [id], onDelete: SetNull)
  status           FixtureStatus @default(AVAILABLE)
  location         String?
  procurementCost  Float? // engineering estimate feed → P5 estimation sheet tooling cost
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([productId])
  @@index([status])
}

enum FixtureStatus {
  AVAILABLE
  UNDER_MAINT
  MISSING
}

// P3 — Drawing revision transmittal: releasing a rev requires Production + Quality
// manager acknowledgement before the shop floor treats it as authoritative.
model DrawingTransmittal {
  id                String    @id @default(cuid())
  documentId        String
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision          Int
  releasedAt        DateTime  @default(now())
  releasedBy        String
  ackProduction     Boolean   @default(false)
  ackProductionBy   String?
  ackProductionAt   DateTime?
  ackQuality        Boolean   @default(false)
  ackQualityBy      String?
  ackQualityAt      DateTime?

  @@unique([documentId, revision])
  @@index([documentId])
}

model Escalation {
  id          String    @id @default(cuid())
  sourceType  String    // AUDIT_FINDING | BUDGET | NCR | CUSTOM | MRM_ACTION
  sourceId    String
  title       String
  severity    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  escalatedAt DateTime  @default(now())
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([sourceType])
}

// ============================================================
// MANAGEMENT REVIEW MEETINGS (ISO 9001 cl.9.3)
// ============================================================

model MrmMeeting {
  id            String         @id @default(cuid())
  meetingNumber String         @unique
  title         String
  date          DateTime
  attendees     Json           // [{ name, role }]
  agenda        Json           // auto-pulled: [{ title, detail, severity, source }]
  summary       String?
  decisions     Json?          // [{ text }]
  minutesBy     String
  status        String         @default("OPEN") // OPEN | CLOSED
  closedByName  String?
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  actionItems   MrmActionItem[]

  @@index([status])
  @@index([date])
}

model MrmActionItem {
  id          String     @id @default(cuid())
  meetingId   String
  meeting     MrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description String
  ownerName   String
  dueDate     DateTime?
  priority    String     @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String     @default("OPEN") // OPEN | DONE
  escalated   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([meetingId])
  @@index([status])
}

// ============================================================
// QUALITY OBJECTIVES (per-dept KPI targets vs live actuals)
// ============================================================

model QualityObjective {
  id         String   @id @default(cuid())
  department String   // department id (e.g. production) or name
  kpiType    String   // OTD_PCT | PPM | MTBF | TRAINING_PCT
  targetValue Float
  period     String   // "YYYY-MM" — the month the target applies to
  ownerName  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([period])
  @@index([kpiType])
}

// ============================================================
// 8D PROBLEM SOLVING / CAPA
// ============================================================

enum EightDStatus {
  D1_TEAM
  D2_PROBLEM
  D3_CONTAINMENT
  D4_ROOT_CAUSE
  D5_CORRECTIVE
  D6_PREVENTIVE
  D7_VERIFY
  D8_CLOSURE
  CLOSED
}

enum CapaActionType {
  CONTAINMENT
  CORRECTIVE
  PREVENTIVE
}

enum CapaActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  VERIFIED
}

model EightDReport {
  id                String          @id @default(cuid())
  reportNumber      String          @unique
  ncrId             String?
  ncr               NcrReport?      @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  complaintId       String?         // M8 — complaint SLA: 8D must close within the 10-day timer
  complaint         CustomerComplaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  workOrderId       String?
  workOrder         WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  title             String
  problemDescription String?
  severity          String          @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status            EightDStatus    @default(D1_TEAM)
  // D1 — Team
  teamMembers       String?
  // D2 — Problem
  problemStatement  String?
  // D3 — Containment
  containmentAction String?
  containmentOwner  String?
  containmentDue    DateTime?
  // D4 — Root cause (5-Why)
  why1              String?
  why2              String?
  why3              String?
  why4              String?
  why5              String?
  rootCauseSummary  String?
  // D5 — Corrective action
  correctiveAction  String?
  correctiveOwner   String?
  correctiveDue     DateTime?
  // D6 — Preventive action
  preventiveAction  String?
  preventiveOwner   String?
  preventiveDue     DateTime?
  // D7 — Verification
  verificationMethod String?
  verifiedAt        DateTime?
  verifiedBy        String?
  // D8 — Closure
  effectivenessScore Int? // 1-10
  closureSummary    String?
  closedAt          DateTime?
  raisedBy          String          @default("System")
  raisedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  actions CapaAction[]

  @@index([status])
  @@index([ncrId])
  @@index([productId])
}

model CapaAction {
  id           String          @id @default(cuid())
  reportId     String
  report       EightDReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type         CapaActionType
  description  String
  owner        String?
  dueDate      DateTime?
  status       CapaActionStatus @default(OPEN)
  verifiedBy   String?
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([reportId])
  @@index([status])
}

// ============================================================
// PPAP (Production Part Approval Process) + CONTROL PLAN
// ============================================================

enum PpapStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum PpapElementStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  N_A
}

enum ControlPlanStatus {
  DRAFT
  ACTIVE
  OBSOLETE
}

model PpapSubmission {
  id            String        @id @default(cuid())
  ppapNumber    String        @unique
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName  String?
  revision      String        @default("A")
  submissionLevel Int         @default(3) // AIAG level 1-5
  status        PpapStatus    @default(DRAFT)
  submittedAt   DateTime?
  dispositionAt DateTime?
  dispositionBy String?
  notes         String?
  createdBy     String        @default("System")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  elements PpapElement[]

  @@index([productId])
  @@index([status])
}

model PpapElement {
  id          String         @id @default(cuid())
  ppapId      String
  ppap        PpapSubmission @relation(fields: [ppapId], references: [id], onDelete: Cascade)
  elementNo   Int
  elementName String
  status      PpapElementStatus @default(NOT_STARTED)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ppapId, elementNo])
  @@index([ppapId])
}

model ControlPlan {
  id                String            @id @default(cuid())
  planNumber        String            @unique
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  revision          String            @default("A")
  status            ControlPlanStatus @default(DRAFT)
  processStep       String?           // e.g. OP20 Milling
  characteristic    String
  specMin           Float?
  specMax           Float?
  measurementMethod String?
  sampleSize        Int?
  frequency         String?           // e.g. Every 10 pcs
  controlMethod     String?
  reactionPlan      String?
  responsible       String?
  notes             String?
  createdBy         String            @default("System")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([productId])
  @@index([status])
}

// ============================================================
// P14 — BUYER BOARD (requisition assignment + PO follow-up)
// ============================================================

model PurchaseRequisition {
  id             String          @id @default(cuid())
  reqNumber      String          @unique
  title          String
  description    String?
  itemName       String?
  qty            Float?
  unit           String?
  estimatedCost  Float?
  urgency        String          @default("NORMAL") // NORMAL | URGENT | CRITICAL
  status         String          @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | PO_ISSUED | CANCELLED
  assignedToId   String?
  assignedTo     User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedByName String?
  assignedAt     DateTime?
  poNumber       String?
  requestedBy    String          @default("Stores")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  followUps      PoFollowUpLog[]

  @@index([status])
  @@index([assignedToId])
  @@index([urgency])
}

model PoFollowUpLog {
  id             String             @id @default(cuid())
  requisitionId  String
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  note           String
  by             String
  at             DateTime           @default(now())

  @@index([requisitionId])
}

// ============================================================
// P15 — CYCLE COUNT PROGRAM (ABC classification + finance approval)
// ============================================================

model CycleCountSession {
  id            String           @id @default(cuid())
  sessionNumber String           @unique
  name          String
  abcClass      String           // A | B | C
  status        String           @default("OPEN") // OPEN | COUNTING | PENDING_APPROVAL | ADJUSTED | CLOSED
  startedBy     String           @default("Stores")
  startedAt     DateTime         @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  approvalNote  String?
  lines         CycleCountLine[]

  @@index([status])
  @@index([abcClass])
}

model CycleCountLine {
  id             String             @id @default(cuid())
  sessionId      String
  session        CycleCountSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawMaterialId  String
  rawMaterial    RawMaterial        @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  systemQty      Float
  countedQty     Float?
  variance       Float?
  variancePct    Float?
  countedBy      String?
  countedAt      DateTime?
  status         String             @default("PENDING") // PENDING | COUNTED | OK | VAR_APPROVED | VAR_REJECTED
  note           String?

  @@index([sessionId])
  @@index([rawMaterialId])
}

// ============================================================
// P16 — MATERIAL ISSUE SLIP (stores → job costing)
// ============================================================

model MaterialIssueSlip {
  id            String      @id @default(cuid())
  issueNumber   String      @unique
  workOrderId   String
  workOrder     WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  qty           Float
  batchNo       String?
  heatNo        String?
  issuedBy      String      @default("Storekeeper")
  issuedTo      String?
  issuedAt      DateTime    @default(now())
  status        String      @default("ISSUED") // ISSUED | RETURNED | PARTIAL_RETURN
  reference     String?
  createdAt     DateTime    @default(now())

  @@index([workOrderId])
  @@index([rawMaterialId])
}

// ============================================================
// P13 — CAL LAB PROCUREMENT (metrology → supply interlink)
// ============================================================

model CalLabRequisition {
  id              String    @id @default(cuid())
  reqNumber       String    @unique
  title           String
  description     String?
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | COMPLETED | REJECTED
  vendorId        String?
  vendor          Supplier? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName      String? // snapshot for history when vendor is unlinked
  estimatedAmount Float     @default(0)
  targetDate      DateTime?
  completedAt     DateTime?
  instruments     Json // [{ id, name, serialNumber, expiresAt, costRupees, status }]
  source          String    @default("MANUAL") // CAL_LAB_AUTO | MANUAL
  requestedBy     String    @default("Metrology")
  requestedAt     DateTime  @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([vendorId])
}

model CalLabVendorRating {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Supplier @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  period         String // YYYY-MM
  onTimeDelivery Float    @default(0) // 0-100 %
  certQuality    Float    @default(0) // 0-100 %
  overallScore   Float    @default(0) // 0.6×OTD + 0.4×cert quality
  grade          String   @default("C") // A | B | C | D
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, period])
  @@index([period])
}

// ============================================================
// P10 — IPQC CHECKLISTS (terminal in-process inspection from Control Plan)
// ============================================================

model IpccChecklistRun {
  id          String        @id @default(cuid())
  runNumber   String        @unique
  workOrderId String
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  machineId   String
  machine     Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  operatorId  String?
  operator    User?         @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  processStep String?
  status      String        @default("OPEN") // OPEN | PASSED | FAILED | REVIEWED
  failedCount Int           @default(0)
  ncrId       String?
  ncr         NcrReport?    @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  checks      IpccCheckResult[]

  @@index([workOrderId])
  @@index([machineId])
  @@index([status])
}

model IpccCheckResult {
  id                String            @id @default(cuid())
  runId             String
  run               IpccChecklistRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  characteristic    String
  processStep       String?
  specMin           Float?
  specMax           Float?
  uom               String?
  measurementMethod String?
  sampleSize        Int?
  frequency         String?
  controlMethod     String?
  measuredValue     Float?
  valueText         String? // attribute checks (OK / NG) when no numeric spec
  result            String            @default("PENDING") // PENDING | PASS | FAIL
  comment           String?
  recordedAt        DateTime?
  recordedBy        String?

  @@index([runId])
}

// ============================================================
// GRN (Goods Receipt Note) + SUPPLIER INVOICE + 3-WAY MATCH
// ============================================================

enum GrnInspectionStatus {
  PENDING
  PASSED
  REJECTED
  HELD // M6 — IQC fail auto-holds the lot (awaiting supplier disposition)
}

enum ThreeWayMatchStatus {
  UNMATCHED
  PARTIAL
  MATCHED
  MISMATCHED
}

model SupplierInvoiceLine {
  id            String             @id @default(cuid())
  invoiceId     String
  invoice       SupplierInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poLineId      String?
  poLine        PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  rawMaterialId String
  rawMaterial   RawMaterial        @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  lineNo        Int                @default(1)
  qty           Float
  unitCost      Float
  amount        Float              @default(0)
  createdAt     DateTime           @default(now())

  @@index([invoiceId])
  @@index([poLineId])
}

model InvoiceLine {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderLineId String? // trace to SalesOrderLine when billing an SO (scalar link)
  productId        String? // product snapshot reference (scalar link)
  productName      String
  productSku       String?
  lineNo           Int      @default(1)
  qty              Float
  unitPrice        Float
  taxableValue     Float    @default(0)
  taxRatePct       Float    @default(0)
  cgstAmt          Float    @default(0)
  sgstAmt          Float    @default(0)
  igstAmt          Float    @default(0)
  totalValue       Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([invoiceId])
  @@index([salesOrderLineId])
}

model ExpenseClaim {
  id              String            @id @default(cuid())
  claimNumber     String            @unique // EXP-YYYY-NNNN
  claimantName    String
  claimantCode    String?
  claimantUserId  String?
  totalAmount     Float             @default(0)
  status          String            @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | PAID
  category        String            @default("OTHER") // primary category of the first item
  expenseDate     DateTime          @default(now())
  submittedBy     String?
  submittedAt     DateTime          @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  paidBy          String?
  paidAt          DateTime?
  paymentMethod   String?
  treasuryRef     String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           ExpenseClaimItem[]

  @@index([status])
  @@index([claimantName])
  @@index([claimantUserId])
  @@index([claimNumber])
}

model ExpenseClaimItem {
  id          String       @id @default(cuid())
  claimId     String
  claim       ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category    String // TRAVEL | FOOD | FUEL | STATIONERY | MARKETING | REPAIR | UTILITY | QUALITY | TOOLING | SUBCONTRACT | TRAINING | OTHER
  description String
  amount      Float
  expenseDate DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([claimId])
}

enum SupplierInvoiceStatus {
  UNPAID
  MATCHED
  MISMATCHED
  PAID
}

model GoodsReceiptNote {
  id               String              @id @default(cuid())
  grnNumber        String              @unique
  poId             String
  po               PurchaseOrder       @relation(fields: [poId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rawMaterialId    String
  rawMaterial      RawMaterial         @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  poLineId         String?
  poLine           PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  receivedQty      Float
  receivedAt       DateTime            @default(now())
  receivedBy       String              @default("Storekeeper")
  batchNo           String?
  inspectionStatus GrnInspectionStatus @default(PENDING)
  inspector        String?
  inspectedAt      DateTime?
  matchStatus      ThreeWayMatchStatus @default(UNMATCHED)
  notes            String?
  lotHeld          Boolean             @default(false) // M6 — IQC fail → lot HOLD
  aqlSampleSize    Int?                          // M6 — AQL sample actually inspected
  ncrId            String?                       @unique // M6 — auto-raised supplier NCR
  ncr              NcrReport?                    @relation("GrnNcr")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  supplierInvoice SupplierInvoice?

  @@index([poId])
  @@index([supplierId])
  @@index([rawMaterialId])
}

// M6 — AQL sampling tables per material class (IQC)
model AqlPlan {
  id                String  @id @default(cuid())
  materialClass     String  @unique // A | B | C
  aqlLevel          String  @default("II")
  sampleSize        Int     // pieces inspected per lot
  acceptanceNumber  Int     // Ac — max defects to accept
  rejectionNumber   Int     // Re — defects to reject (Ac+1 typically)
  description       String?
  createdAt         DateTime @default(now())
}

// M7 — Final QC dispatch checklist (final insp + packing + doc pack)
model FqcChecklist {
  id                    String    @id @default(cuid())
  workOrderId           String    @unique
  workOrder             WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  finalInspectionPassed Boolean   @default(false)
  packingDone           Boolean   @default(false)
  docPackDone           Boolean   @default(false) // data-package gate (DP-…) released
  inspector             String    @default("")
  checkedAt             DateTime? @default(now())
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// M9 — QMS document control (annual review)
model QmsDocument {
  id            String    @id @default(cuid())
  docNumber     String    @unique
  title         String
  docType       String    @default("PROCEDURE") // POLICY | PROCEDURE | WORK_INSTRUCTION | FORM | RECORD
  owner         String    @default("Quality Manager")
  revision      String    @default("A")
  status        String    @default("CURRENT") // CURRENT | UNDER_REVIEW | OBSOLETE
  approvedAt    DateTime?
  nextReviewAt  DateTime
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SupplierInvoice {
  id            String              @id @default(cuid())
  invoiceNumber String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  poId          String?
  po            PurchaseOrder?      @relation(fields: [poId], references: [id], onDelete: SetNull)
  grnId         String?             @unique
  grn           GoodsReceiptNote?   @relation(fields: [grnId], references: [id], onDelete: SetNull)
  lines         SupplierInvoiceLine[]
  amount        Float               @default(0) // net goods value
  taxAmount     Float               @default(0)
  totalAmount   Float               @default(0)
  invoiceDate   DateTime            @default(now())
  dueDate       DateTime?
  status        SupplierInvoiceStatus @default(UNPAID)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([supplierId])
  @@index([poId])
  @@index([status])
}

// ============================================================
// GAGE R&R (Measurement System Analysis)
// ============================================================

enum GrrVerdict {
  ACCEPTABLE
  CONDITIONAL
  UNACCEPTABLE
}

model GageRnrStudy {
  id           String        @id @default(cuid())
  studyNumber  String        @unique
  toolId       String
  tool         CalibratedTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  appraisers   Int           @default(3)
  parts        Int           @default(10)
  trials       Int           @default(3)
  measurements Json          // { appraiser: string, part: number, trial: number, value: number }[]
  // Computed (stored on save; recompute live on GET)
  ev           Float?
  av           Float?
  grr          Float?
  partVar      Float?
  totalVar     Float?
  grrPct       Float?
  ndc          Int?
  verdict      GrrVerdict?
  conductedBy  String        @default("System")
  conductedAt  DateTime      @default(now())
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([toolId])
}

model PermitToWork {
  id              String    @id @default(cuid())
  permitNo        String    @unique
  maintenanceJobId String
  maintenanceJob  MaintenanceJob @relation(fields: [maintenanceJobId], references: [id], onDelete: Cascade)
  type            String // HOT_WORK | HEIGHT_WORK | CONFINED_SPACE | ELECTRICAL | EXCAVATION
  description     String
  location        String
  requestedBy     String
  requestedAt     DateTime  @default(now())
  status          String    @default("PENDING") // PENDING | APPROVED | VOID | EXPIRED
  ehsApprovedBy   String?
  ehsApprovedAt   DateTime?
  ehsApprovedReason String?
  maintApprovedBy String?
  maintApprovedAt DateTime?
  maintApprovedReason String?
  prodApprovedBy  String?
  prodApprovedAt  DateTime?
  prodApprovedReason String?
  validFrom       DateTime
  validUntil      DateTime
  voidedAt        DateTime?
  voidedBy        String?
  adjustmentHistory Json?

  @@index([maintenanceJobId])
  @@index([status])
  @@index([validUntil])
}

model AccessReviewCycle {
  id          String   @id @default(cuid())
  name        String
  periodStart DateTime
  dueDate     DateTime
  status      String   @default("OPEN") // OPEN | CLOSED
  createdBy   String
  createdAt   DateTime @default(now())
  closedAt    DateTime?
  certifications AccessCertification[]

  @@index([status])
  @@index([dueDate])
}

model AccessCertification {
  id          String   @id @default(cuid())
  cycleId     String
  cycle       AccessReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  depts       String[] // department keys certified, e.g. ["ops","quality"]
  certifiedBy String
  certifiedAt DateTime @default(now())
  notes       String?

  @@unique([cycleId, userId])
  @@index([cycleId])
  @@index([userId])
}

model RestoreDrill {
  id            String    @id @default(cuid())
  drillDate     DateTime  @default(now())
  performedBy   String
  backupJobId   String?
  backupJob     BackupJob? @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  backupName    String
  backupSizeMb  Float?
  result        String    @default("PASS") // PASS | FAIL | PARTIAL
  durationSec   Int?
  verifiedAt    DateTime
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([drillDate])
  @@index([result])
}

// ============================================================
// M17 — MAKER-CHECKER VOUCHERS (worker enters, manager checks/posts)
// ============================================================

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  DEPRECIATION
  ADJUSTMENT
}

enum VoucherStatus {
  PENDING_CHECK // maker entered — NOT posted, no ledger effect
  POSTED // manager checked and posted — cash types mirrored to treasury
  REJECTED // manager sent back with a written reason
}

model Voucher {
  id              String        @id @default(cuid())
  voucherNumber   String        @unique
  voucherType     VoucherType   @default(JOURNAL)
  amount          Float
  account         String        @default("Main")
  particulars     String
  voucherDate     DateTime      @default(now())
  status          VoucherStatus @default(PENDING_CHECK)
  enteredBy       String
  checkedBy       String?
  checkedAt       DateTime?
  rejectReason    String?
  postedToTreasury Boolean      @default(false)
  sourceAssetId   String? // M19 — the FixedAsset this DEPRECIATION voucher covers
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assetEntries AssetDepreciationEntry[]

  @@index([status])
  @@index([voucherDate])
}

// ============================================================
// M19 — FIXED ASSETS + DEPRECIATION
// ============================================================

enum FixedAssetCategory {
  MACHINERY
  VEHICLE
  FURNITURE_FIXTURES
  COMPUTER_EQUIPMENT
  EQUIPMENT
  BUILDING
  LAND
  OTHER
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WDV // written-down value (declining balance)
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

model FixedAsset {
  id                    String              @id @default(cuid())
  assetCode             String              @unique
  name                  String
  category              FixedAssetCategory  @default(MACHINERY)
  purchaseDate          DateTime
  cost                  Float
  salvageValue          Float               @default(0)
  usefulLifeMonths      Int                 @default(60)
  method                DepreciationMethod  @default(STRAIGHT_LINE)
  accumulatedDepreciation Float             @default(0)
  bookValue             Float
  status                FixedAssetStatus    @default(ACTIVE)
  disposedAt            DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  entries AssetDepreciationEntry[]

  @@index([status])
  @@index([category])
}

model AssetDepreciationEntry {
  id          String        @id @default(cuid())
  assetId     String
  asset       FixedAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period      String        // YYYY-MM, e.g. "2026-08"
  amount      Float
  bookedAt    DateTime      @default(now())
  bookedBy    String
  voucherId   String?
  voucher     Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@unique([assetId, period])
  @@index([period])
}

// ============================================================
// M18 — GST RECONCILIATION (GSTR-2B-style CSV vs purchase register)
// ============================================================

enum GstReconStatus {
  OPEN
  CLOSED
}

model GstReconRun {
  id          String         @id @default(cuid())
  period      String         // YYYY-MM — the return month the 2B covers
  label       String?        // file name / note for the upload
  rows        Json           // [{ gstin, supplierName, invoiceNumber, invoiceDate, taxable, tax, total, status, diff }]
  stats       Json           // { matched, amountDiff, notInRegister, missingFromCsv, total, registerTotal }
  followUps   Json           // [{ at, by, note }]
  status      GstReconStatus @default(OPEN)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([period])
  @@index([status])
}

// ===== M20�M23 HR wave =====

enum TrainingStatus {
  PLANNED
  COMPLETED
}

enum TrainingAttendanceStatus {
  SCHEDULED
  ATTENDED
  PASSED
  FAILED
}

model TrainingProgram {
  id            String   @id @default(cuid())
  programNumber String   @unique // TRN-YYYY-NNN
  title         String
  category      String
  trainer       String?
  scheduledDate DateTime
  passingScore  Float    @default(70)
  status        TrainingStatus @default(PLANNED)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attendees     TrainingAttendance[]

  @@index([status])
  @@index([scheduledDate])
}

model TrainingAttendance {
  id        String   @id @default(cuid())
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Float?
  status    TrainingAttendanceStatus @default(SCHEDULED)
  checkedAt DateTime?
  checkedBy String?
  createdAt DateTime @default(now())

  @@unique([programId, userId])
  @@index([userId])
  @@index([status])
}

enum GrievanceStage {
  RAISED
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
}

model Grievance {
  id               String        @id @default(cuid())
  grievanceNumber  String        @unique // GRV-YYYY-NNN
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String
  description      String
  stage            GrievanceStage @default(RAISED)
  raisedAt         DateTime      @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  investigatedAt   DateTime?
  investigatedBy   String?
  resolution       String?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([stage])
  @@index([userId])
}

enum DisciplinaryStage {
  NOTICE
  HEARING
  DECISION
  CLOSED
}

enum DisciplinaryDecision {
  NO_ACTION
  WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
}

model DisciplinaryCase {
  id              String             @id @default(cuid())
  caseNumber      String             @unique // DISC-YYYY-NNN
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  description     String
  stage           DisciplinaryStage  @default(NOTICE)
  noticeIssuedAt  DateTime           @default(now())
  hearingDate     DateTime?
  hearingHeldAt   DateTime?
  decision        DisciplinaryDecision?
  decisionNote    String?
  decidedBy       String?
  decidedAt       DateTime?
  closedBy        String?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([stage])
  @@index([userId])
}

model Contractor {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique // CNT-YYYY-NNN
  gstin             String?
  address           String?
  phone             String?
  licenseNumber     String   @unique
  licenseValidUntil DateTime
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  labour            ContractLabourRecord[]

  @@index([licenseValidUntil])
}

model ContractLabourRecord {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  workType     String
