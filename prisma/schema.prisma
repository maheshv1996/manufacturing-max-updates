model Quotation {
  id                String          @id @default(cuid())
  quoteNumber       String          @unique
  customerName      String
  customerContact   String?
  status            QuotationStatus @default(DRAFT)
  validUntil        DateTime?
  estimatedCost     Float           @default(0)
  quotedPrice       Float           @default(0)
  marginPct         Float           @default(0)
  notes             String?
  workOrderId       String?
